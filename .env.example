# Copy to .env and fill in. `npm start` reads it automatically.

# Ollama cloud (https://ollama.com -> Settings -> API keys)
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
# Any model your key can use; big models design better fusions.
OLLAMA_MODEL=gpt-oss:120b
# json (default) | schema (full JSON-Schema structured output) | none
OLLAMA_FORMAT=json
# Optional reasoning effort for thinking models: low | medium | high
OLLAMA_THINK=

# For a local Ollama instead: OLLAMA_HOST=http://localhost:11434 (no key needed)
# LLM_PROVIDER=mock   # deterministic fake LLM for testing without a key

PORT=8787
FORGE_CONCURRENCY=2
FORGE_MAX_REPAIRS=3
# New generations per player IP per hour, and across everyone per UTC day.
FORGE_RATE_LIMIT=60
FORGE_DAILY_CAP=500
BALANCE_WORKERS=1

# Public deployment (see docs/deploy.md):
# CORS_ORIGINS=https://your-name.github.io   # the site allowed to call this API
# TRUST_PROXY=1                              # behind Railway / Fly / Render
# DB_PATH=/data/infinitetower.db             # on a persistent volume
